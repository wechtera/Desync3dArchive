# Copy to .env and adjust. The README's Configuration section explains each setting.

# development or production. Anything other than production refuses production paths.
APP_ENV=development

# Required. Holds library.db, metadata/, previews/, scrapes/, logs/ and the browser profile.
# Use an absolute path outside this repository.
DESYNC_DATA_DIR=/Users/you/DESYNC_Data_dev

# Colon-separated. The NAS vault, staging and stash export folders that development must never
# touch. Required in development. Used by the production guard.
DESYNC_PROTECTED_PATHS=/Volumes/your_nas:/Users/you/vault_staging:/Users/you/stash_export

# Optional. Loopback only unless LAN mode is set up below.
# DESYNC_HOST=127.0.0.1
# DESYNC_PORT=8080
# Comma-separated hostnames allowed in addition to localhost, 127.0.0.1 and ::1.
# DESYNC_ALLOWED_HOSTS=

# LAN mode. Setting DESYNC_HOST beyond loopback requires login, a password and both TLS files,
# or the app refuses to start. Create the password with: dbtool set-password
# DESYNC_TLS_CERT=/path/to/vault.local.pem
# DESYNC_TLS_KEY=/path/to/vault.local-key.pem
# DESYNC_SECRETS_FILE=~/.config/desync-archival/secrets.json
# DESYNC_REQUIRE_LOGIN=1

# Colon-separated. The only folders the API can browse or set paths in, and Import File can read.
DESYNC_ALLOWED_ROOTS=/Users/you/DESYNC_Data_dev

# Where backups go. Must be outside the data directory, and on another disk in production.
DESYNC_BACKUP_DIR=/Users/you/DESYNC_Backups_dev

# Optional second copy, such as a folder on the NAS. Secrets aren't copied there. Both folders can
# also be set in Settings > Backups, which wins over these.
# DESYNC_BACKUP_MIRROR_DIR=/Volumes/NAS/Backups
